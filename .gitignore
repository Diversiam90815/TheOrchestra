CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
Testing/
**/CMakeFiles/*

# JUCE
JuceLibraryCode/
Builds/

# IDE / editor
.vs/
.vscode/
.idea/
.cache/
*.user
*.suo
*.sln.docstates
*.VC.db
*.VC.opendb

# Python helpers
__pycache__/
*.py[cod]
.venv/
venv/

# Signing material - must never be committed
*.pfx
*.p12
*.cer
*.key

# OS noise
.DS_Store
Thumbs.db
desktop.ini

