###############################################################################
# The Orchestra - git attributes
###############################################################################

# Normalise line endings for text, but let git decide what is text.
* text=auto

# Source
*.c      text diff=cpp
*.cpp    text diff=cpp
*.h      text diff=cpp
*.hpp    text diff=cpp
*.cmake  text
*.txt    text
*.md     text diff=markdown
*.json   text
*.py     text diff=python
*.yml    text
*.yaml   text

# Audio - never touch these
*.flac   binary
*.wav    binary
*.aiff   binary
*.aif    binary
*.mp3    binary
*.ogg    binary

# Images
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary

# Fonts
*.otf    binary
*.ttf    binary
*.woff   binary
*.woff2  binary

# Other binaries
*.pdf    binary
*.zip    binary
*.vst3   binary
*.dll    binary
*.exe    binary
*.lib    binary
*.pdb    binary

# Keep the sample pack out of language statistics and diffs.
Assets/Samples/** linguist-vendored
